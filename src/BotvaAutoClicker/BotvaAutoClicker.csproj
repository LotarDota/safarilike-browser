<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>BotvaAutoClicker</RootNamespace>
    <AssemblyName>BotvaAutoClicker</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Allow cross-compiling the Windows-targeted project from Linux CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CefSharp .NET (Core) packages provide the embedded Chromium browser for
      net8.0-windows. The CEF native runtime is brought in transitively by
      CefSharp.Common.NETCore, so no explicit chromiumembeddedframework.runtime
      reference is needed here.
    -->
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="146.0.100" />
    <PackageReference Include="CefSharp.Common.NETCore" Version="146.0.100" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
